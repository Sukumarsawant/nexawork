# Browser-safe values. Never put a service-role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only AI provider. Leave blank to disable AI assistance.
GEMINI_API_KEY=
# Optional resume temp root; directories are deleted after processing.
RESUME_TEMP_ROOT=/var/tmp
# Optional comma-separated exact dev preview hostnames (no scheme or port).
NEXT_ALLOWED_DEV_ORIGINS=
