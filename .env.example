# Browser-safe values. Never put a service-role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only AI provider. Leave blank to disable AI assistance.
GEMINI_API_KEY=
# Optional resume temp root; directories are deleted after processing.
RESUME_TEMP_ROOT=/var/tmp
# Optional comma-separated exact dev preview hostnames (no scheme or port).
NEXT_ALLOWED_DEV_ORIGINS=

# Optional hosted-preview workaround ONLY. Leave unset for normal deployments.
# NEXT_PUBLIC_PREVIEW_AUTH_PROXY=true
# NEXT_PUBLIC_SUPABASE_URL=https://your-preview-host/api/supabase
# SUPABASE_PREVIEW_TARGET=http://127.0.0.1:54321
# SUPABASE_SERVER_URL=http://127.0.0.1:54321
